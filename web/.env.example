# Copy to .env.local (never commit .env.local). The app runs with just the two Supabase values;
# everything else switches a feature on.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only — llm_cache writes and `npm run seed`. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# AI — primary path is n8n (see /n8n/README.md); Groq direct is the fallback.
N8N_WEBHOOK_URL=
N8N_SECRET=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Trip intel news — newsdata.io free plan (200 credits/day, commercial use allowed)
NEWSDATA_API_KEY=

# Identifies you to OpenStreetMap's Nominatim and Overpass, as their usage policy asks,
# e.g. "Tabiato/1.0 (you@example.com)"
OSM_USER_AGENT=

# Which Overpass server finds nearby places for the planner. The public one is free but often
# busy; set this to a mirror if "Ato suggests" keeps coming back empty.
OVERPASS_URL=https://overpass-api.de/api/interpreter

# "Try the demo" on the login page signs in as this account. Must match the password `npm run seed`
# used (it reads DEMO_PASSWORD too). Leave empty to hide the button.
DEMO_EMAIL=eexin@demo.tabiato.app
DEMO_PASSWORD=

# Google Form for tester feedback — shown on Profile and in the desktop sidebar when set
NEXT_PUBLIC_FEEDBACK_URL=

# Show "Continue with Google" — set to true only after enabling Google in Supabase (docs/DEPLOY.zh.md 5a-2)
NEXT_PUBLIC_ENABLE_GOOGLE=
